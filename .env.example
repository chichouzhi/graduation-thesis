FLASK_ENV=production
FLASK_APP=wsgi:app
PYTHONUNBUFFERED=1
DATABASE_URL=postgresql+psycopg://gd:gd@postgres:5432/gd
BROKER_URL=redis://redis:6379/0
SECRET_KEY=<set-a-unique-secret-with-at-least-32-characters>
JWT_SECRET_KEY=<set-a-unique-jwt-secret-with-at-least-32-characters>
LLM_PROVIDER=openai_compatible
LLM_HTTP_BASE_URL=https://api.openai.com/v1
LLM_HTTP_MODEL=gpt-4.1-mini
LLM_HTTP_API_KEY=<set-your-openai-compatible-api-key>
LLM_HTTP_TIMEOUT_S=60
