FLASK_ENV=development
FLASK_APP=wsgi:app
PYTHONUNBUFFERED=1
DATABASE_URL=postgresql+psycopg://gd:gd@postgres:5432/gd
BROKER_URL=redis://redis:6379/0
LLM_PROVIDER=mock
# To test a real OpenAI-compatible provider locally, replace the mock setting above with:
# LLM_PROVIDER=openai_compatible
# LLM_HTTP_BASE_URL=https://api.openai.com/v1
# LLM_HTTP_MODEL=gpt-4.1-mini
# LLM_HTTP_API_KEY=your-real-openai-compatible-api-key
# LLM_HTTP_TIMEOUT_S=60
# For production, also set explicit SECRET_KEY and JWT_SECRET_KEY values with at least 32 characters.
